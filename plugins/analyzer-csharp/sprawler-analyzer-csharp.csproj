<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sprawler C# analyzer plugin (protocol sprawler.analyzer/1). Uses the Roslyn assemblies bundled with the installed .NET SDK,
       so it needs no NuGet restore. Build output goes to ~/.cache/sprawler (installed by `sprawler plugin add csharp`). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>sprawler-analyzer-csharp</AssemblyName>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
